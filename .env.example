# Copy to .env.local and fill in. Never commit .env.local.
# VITE_* values are bundled into the browser, so only put public keys there.

# --- Required: the app shows a setup screen until these are set ---
# Clerk (auth): dashboard.clerk.com -> API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Supabase (database): supabase.com -> Project settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Required for AI plans and the AI coach chat (server only) ---
OPENAI_API_KEY=sk-xxx
# Optional, defaults to gpt-4.1-nano
# OPENAI_MODEL=gpt-4.1-nano

# --- Optional: emails (welcome email, 7-day feedback email, unsubscribe) ---
# Without these, signup still works and emails are skipped.
BREVO_API_KEY=
# Must be a sender address you verified in Brevo (a Gmail works until you have a domain)
EMAIL_FROM=
EMAIL_FROM_NAME=NuvioFit
# Shown as the support address in emails; defaults to EMAIL_FROM
CONTACT_EMAIL=
# Any long random string, used to sign unsubscribe links
UNSUBSCRIBE_SECRET=
# Server-side Supabase access for the email cron + unsubscribe (Project settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=
# Protects the monthly email cron; Vercel sends it automatically when set in the project
CRON_SECRET=

# Public URL used in email links. On Vercel this defaults to your *.vercel.app URL.
# APP_URL=https://nuviofit.vercel.app

# --- Optional: Google Analytics 4 ---
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
