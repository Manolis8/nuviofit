{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.nuviofit.com"
        }
      ],
      "destination": "https://nuviofit.com/:1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/brevo",
      "schedule": "0 9 1 * *"
    }
  ]
}
